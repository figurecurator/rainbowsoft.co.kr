{
  "name": "rainbowsoft-home",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "rainbowsoft.co.kr", "custom_domain": true },
    { "pattern": "www.rainbowsoft.co.kr", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
